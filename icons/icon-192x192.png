<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192" width="192" height="192">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7c3aed;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#06b6d4;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="192" height="192" rx="42" fill="url(#bg)"/>
  <g transform="translate(96,96)">
    <!-- TV shape -->
    <rect x="-48" y="-38" width="96" height="68" rx="8" fill="none" stroke="white" stroke-width="6"/>
    <rect x="-20" y="30" width="40" height="6" rx="3" fill="white" opacity="0.8"/>
    <!-- Music note inside TV -->
    <circle cx="8" cy="-8" r="12" fill="white" opacity="0.9"/>
    <rect x="18" y="-32" width="4" height="28" rx="2" fill="white" opacity="0.9"/>
    <path d="M18,-32 Q26,-36 22,-28" fill="white" opacity="0.9"/>
  </g>
</svg>
